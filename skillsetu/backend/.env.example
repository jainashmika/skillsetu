# Copy to .env and adjust. Every value has a safe development default.
NODE_ENV=development
PORT=4000
# Required in production:
JWT_SECRET=
# 64 hex characters (32 bytes) for AES-256-GCM field encryption
DATA_ENCRYPTION_KEY=
HMAC_KEY=
PUBLIC_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Show OTP codes in API responses (dev/demo only; never in production with a real SMS gateway)
EXPOSE_OTP=true
# Share of calls to mock government/SMS gateways that fail transiently (to exercise retries)
SIMULATED_FAILURE_RATE=0.15
LOG_REQUESTS=true
